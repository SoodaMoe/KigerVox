<view class="container">
  <view class="header">
    <view class="header-title {{guideStep === 3 ? 'guide-glow' : ''}}" bindlongpress="onHeaderLongPress">{{headerTitle}}</view>
    <view class="guide-pin guide-pin-below" wx:if="{{guideStep === 3}}">
      <text class="guide-pin-label">长按修改为自己的 CN</text>
      <view class="guide-pin-arrow guide-pin-arrow-up"></view>
    </view>
  </view>

  <view class="toolbar">
    <view class="guide-pin guide-pin-left" wx:if="{{guideStep === 4}}">
      <text class="guide-pin-label">点这里配置 API</text>
      <view class="guide-pin-arrow guide-pin-arrow-right"></view>
    </view>
    <view class="toolbar-btn {{guideStep === 4 ? 'guide-glow' : ''}}" bindtap="onOpenSettings">
      <text class="toolbar-text">API 设置</text>
    </view>
  </view>

  <view class="image-section">
    <view class="image-btn {{imgSrc ? 'image-btn-active' : ''}} {{guideStep === 2 ? 'guide-glow' : ''}}" bindtap="onImageTap" bindlongpress="onImageLongPress">
      <view class="image-btn-left">
        <text class="image-btn-label">{{imgLabel || '图片'}}</text>
      </view>
      <text class="image-btn-hint">短按显示；长按修改</text>
    </view>
    <view class="guide-pin guide-pin-below" wx:if="{{guideStep === 2}}">
      <view class="guide-pin-arrow guide-pin-arrow-up"></view>
      <text class="guide-pin-label">长按选择图片</text>
    </view>
  </view>

  <view class="button-grid">
    <view
      class="btn-card {{speakingIndex === index ? 'btn-speaking' : ''}}"
      wx:for="{{buttons}}"
      wx:key="id"
      bindtap="onPlayText"
      bindlongpress="onEditButton"
      data-index="{{index}}"
    >
      <view class="btn-card-body">
        <text class="btn-text">{{item.text}}</text>
      </view>
      <view class="btn-card-footer">
        <text class="btn-hint {{item.silent ? 'btn-hint-silent' : ''}}">{{item.silent ? '点击显示' : '点击播放'}}</text>
      </view>
    </view>

    <view class="btn-card btn-add {{guideStep === 1 ? 'guide-glow' : ''}}" bindtap="onAddButton">
      <view class="btn-card-body">
        <text class="add-icon">+</text>
      </view>
      <view class="btn-card-footer">
        <text class="btn-hint">添加按钮</text>
      </view>
    </view>

    <view class="guide-pin guide-pin-above" wx:if="{{guideStep === 1}}">
      <text class="guide-pin-label">点击按钮朗读文字</text>
      <view class="guide-pin-arrow guide-pin-arrow-down"></view>
    </view>

  </view>

  <view class="footer">
    <text class="footer-text">{{headerSubtitle}}</text>
    <text class="footer-text">长按按钮可编辑或删除</text>
  </view>
</view>

<view class="overlay" wx:if="{{showOverlay}}" bindtap="onOverlayTap">
  <view class="overlay-text">{{overlayText}}</view>
  <view class="overlay-hint">点击任意位置返回</view>
</view>

<view class="modal-mask" wx:if="{{showModal}}" bindtap="onModalCancel"></view>
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-header">
    <text class="modal-title">编辑按钮文字</text>
  </view>
  <view class="modal-body">
    <input
      class="modal-input"
      value="{{editingText}}"
      bindinput="onTextInput"
      placeholder="请输入按钮文字"
      maxlength="50"
      focus="{{true}}"
      confirm-type="done"
      bindconfirm="onModalConfirm"
    />
  </view>
  <view class="modal-footer">
    <button class="modal-btn modal-btn-cancel" bindtap="onModalCancel">取消</button>
    <button class="modal-btn modal-btn-confirm" bindtap="onModalConfirm">确定</button>
  </view>
</view>

<view class="image-overlay" wx:if="{{showImage}}" bindtap="onImageClose" bindlongpress="onImageChange">
  <image class="image-overlay-img" src="{{imgSrc}}" mode="aspectFit" />
  <view class="image-overlay-hint">点击任意位置返回 | 长按更换图片</view>
</view>

<!-- ═══ New User Guide ═══ -->

<!-- Step 0: fullscreen dialog -->
<view class="guide-mask" wx:if="{{guideStep === 0}}" catchtap="noop">
  <view class="guide-dialog">
    <view class="guide-dialog-title">新手指引</view>
    <view class="guide-dialog-body">检测到你是第一次使用，是否需要新手指引？</view>
    <view class="guide-dialog-btns">
      <button class="guide-btn guide-btn-no" bindtap="onGuideNo">跳过</button>
      <button class="guide-btn guide-btn-yes" bindtap="onGuideYes">开始指引</button>
    </view>
  </view>
</view>

<!-- Bottom card overlay for steps 1-4 -->
<view class="guide-card" wx:if="{{guideStep >= 1}}">
  <view class="guide-card-blocker" catchtap="onGuideNext"></view>
  <view class="guide-card-inner" catchtap="noop">
    <!-- Step indicators -->
    <view class="guide-dots">
      <view class="guide-dot {{guideStep === 1 ? 'guide-dot-on' : ''}}"></view>
      <view class="guide-dot {{guideStep === 2 ? 'guide-dot-on' : ''}}"></view>
      <view class="guide-dot {{guideStep === 3 ? 'guide-dot-on' : ''}}"></view>
      <view class="guide-dot {{guideStep === 4 ? 'guide-dot-on' : ''}}"></view>
    </view>
    <!-- Title -->
    <view class="guide-card-title">{{guideStep === 1 ? '文字朗读' : (guideStep === 2 ? '图片展示' : (guideStep === 3 ? '修改标题' : 'API 设置'))}}</view>
    <!-- Content -->
    <view class="guide-card-desc">
      <block wx:if="{{guideStep === 1}}"><text>点击右下角 </text><text class="guide-em">＋</text><text> 新建按钮；</text><text class="guide-em">点击</text><text>按钮可语音朗读文字；</text><text class="guide-em">长按</text><text>按钮可修改文字、切换静音模式或删除。</text></block>
      <block wx:if="{{guideStep === 2}}"><text>在标题下方，</text><text class="guide-em">长按</text><text>这里可以选择一张你的</text><text class="guide-em">扩列图</text><text>，短按这里就能全屏展示图片。</text></block>
      <block wx:if="{{guideStep === 3}}"><text class="guide-em">长按</text><text>顶部标题，可以把文字修改为自己的</text><text class="guide-em">CN</text><text>。</text></block>
      <block wx:if="{{guideStep === 4}}"><text>右上角 </text><text class="guide-em">API 设置</text><text> 中可以配置</text><text class="guide-em">自己的 TTS API</text><text>，支持腾讯云、阿里云和自定义接口。</text></block>
    </view>
    <!-- Buttons -->
    <view class="guide-card-btns">
      <button class="guide-btn guide-btn-no" bindtap="onGuideNo">跳过</button>
      <button class="guide-btn guide-btn-yes" bindtap="onGuideNext">{{guideStep === 4 ? '完成' : '下一步'}}</button>
    </view>
  </view>
</view>
