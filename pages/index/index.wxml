<view class="container">
  <view class="header">
    <view class="header-title" bindlongpress="onHeaderLongPress">{{headerTitle}}</view>
    <view class="header-subtitle">{{headerSubtitle}}</view>
  </view>

  <view class="toolbar">
    <view class="toolbar-btn" bindtap="onOpenSettings">
      <text class="toolbar-text">API 设置</text>
    </view>
  </view>

  <view class="image-section">
    <view class="image-btn {{imgSrc ? 'image-btn-active' : ''}}" bindtap="onImageTap" bindlongpress="onImageLongPress">
      <view class="image-btn-left">
        <text class="image-btn-label">{{imgLabel || '图片'}}</text>
      </view>
      <text class="image-btn-hint">短按显示；长按修改</text>
    </view>
  </view>

  <view class="button-grid">
    <view
      class="btn-card {{speakingIndex === index ? 'btn-speaking' : ''}}"
      wx:for="{{buttons}}"
      wx:key="id"
      bindtap="onPlayText"
      bindlongpress="onEditButton"
      data-index="{{index}}"
    >
      <view class="btn-card-body">
        <text class="btn-text">{{item.text}}</text>
      </view>
      <view class="btn-card-footer">
        <text class="btn-hint {{item.silent ? 'btn-hint-silent' : ''}}">{{item.silent ? '点击显示' : '点击播放'}}</text>
      </view>
    </view>

    <view class="btn-card btn-add" bindtap="onAddButton">
      <view class="btn-card-body">
        <text class="add-icon">+</text>
      </view>
      <view class="btn-card-footer">
        <text class="btn-hint">添加按钮</text>
      </view>
    </view>

  </view>

  <view class="footer">
    <text class="footer-text">长按按钮可编辑或删除</text>
  </view>
</view>

<view class="overlay" wx:if="{{showOverlay}}" bindtap="onOverlayTap">
  <view class="overlay-text">{{overlayText}}</view>
  <view class="overlay-hint">点击任意位置返回</view>
</view>

<view class="modal-mask" wx:if="{{showModal}}" bindtap="onModalCancel"></view>
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-header">
    <text class="modal-title">编辑按钮文字</text>
  </view>
  <view class="modal-body">
    <input
      class="modal-input"
      value="{{editingText}}"
      bindinput="onTextInput"
      placeholder="请输入按钮文字"
      maxlength="50"
      focus="{{true}}"
      confirm-type="done"
      bindconfirm="onModalConfirm"
    />
  </view>
  <view class="modal-footer">
    <button class="modal-btn modal-btn-cancel" bindtap="onModalCancel">取消</button>
    <button class="modal-btn modal-btn-confirm" bindtap="onModalConfirm">确定</button>
  </view>
</view>

<view class="image-overlay" wx:if="{{showImage}}" bindtap="onImageClose" bindlongpress="onImageChange">
  <image class="image-overlay-img" src="{{imgSrc}}" mode="aspectFit" />
  <view class="image-overlay-hint">点击任意位置返回 | 长按更换图片</view>
</view>

<!-- ═══ New User Guide ═══ -->
<view class="guide-mask" wx:if="{{guideStep >= 0}}" catchtap="onGuideNext">

  <!-- Step 0: prompt -->
  <view class="guide-dialog" wx:if="{{guideStep === 0}}" catchtap="noop">
    <view class="guide-dialog-title">新手指引</view>
    <view class="guide-dialog-body">检测到你是第一次使用，是否需要新手指引？</view>
    <view class="guide-dialog-btns">
      <button class="guide-btn guide-btn-no" bindtap="onGuideNo">跳过</button>
      <button class="guide-btn guide-btn-yes" bindtap="onGuideYes">开始指引</button>
    </view>
  </view>

  <!-- Step 1: text buttons -->
  <view class="guide-spotlight guide-s1" wx:if="{{guideStep === 1}}" catchtap="onGuideNext">
    <view class="guide-highlight guide-hl-wide"></view>
    <view class="guide-bubble guide-bubble-center">
      <text>在这里你可以</text>
      <text class="guide-em">新建按钮</text>
      <text>，点击按钮可以</text>
      <text class="guide-em">语音朗读</text>
      <text>文字；</text>
      <text class="guide-em">长按</text>
      <text>按钮可以修改文字或切换静音模式。</text>
    </view>
    <view class="guide-footer">轻触任意位置继续</view>
  </view>

  <!-- Step 2: image button -->
  <view class="guide-spotlight guide-s2" wx:if="{{guideStep === 2}}" catchtap="onGuideNext">
    <view class="guide-highlight guide-hl-row"></view>
    <view class="guide-bubble guide-bubble-bottom">
      <text>在这里长按可以选择一张你的</text>
      <text class="guide-em">扩列图</text>
      <text>，单击这里就能展示</text>
    </view>
    <view class="guide-footer">轻触任意位置继续</view>
  </view>

  <!-- Step 3: header title -->
  <view class="guide-spotlight guide-s3" wx:if="{{guideStep === 3}}" catchtap="onGuideNext">
    <view class="guide-highlight guide-hl-top"></view>
    <view class="guide-bubble guide-bubble-below">
      <text>长按这里可以把文字修改为自己的</text>
      <text class="guide-em">CN</text>
    </view>
    <view class="guide-footer">轻触任意位置继续</view>
  </view>

  <!-- Step 4: API settings -->
  <view class="guide-spotlight guide-s4" wx:if="{{guideStep === 4}}" catchtap="onGuideNext">
    <view class="guide-highlight guide-hl-settings"></view>
    <view class="guide-bubble guide-bubble-left">
      <text>在这里可以配置</text>
      <text class="guide-em">自己的 TTS API</text>
      <text>，支持腾讯云、阿里云和自定义接口。</text>
    </view>
    <view class="guide-footer">轻触任意位置开始使用</view>
  </view>

</view>
