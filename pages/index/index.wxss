.container {
  padding: 32rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
}

.toolbar-text {
  font-size: 24rpx;
  color: #666;
}

.button-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.btn-card {
  width: 31%;
  margin-right: 3.5%;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.btn-card:nth-child(3n) {
  margin-right: 0;
}

.btn-card:active {
  transform: scale(0.95);
}

.btn-card-body {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  padding: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.btn-card-footer {
  background: #fafafa;
  padding: 12rpx 8rpx;
  text-align: center;
  border-top: 1rpx solid #f0f0f0;
}

.btn-hint {
  font-size: 22rpx;
  color: #ccc;
}

.btn-hint-silent {
  color: #87CEEB;
}

.btn-speaking {
  border: 3rpx solid #07C160;
  box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.3);
  animation: speaking-pulse 0.8s ease-in-out infinite;
}

@keyframes speaking-pulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.3);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(7, 193, 96, 0.6);
  }
}

.btn-add {
  border: 2rpx dashed #ddd;
  box-shadow: none;
  background: transparent;
}

.btn-add:active {
  border-color: #07C160;
}

.btn-add .btn-card-body {
  height: 160rpx;
}

.add-icon {
  font-size: 64rpx;
  color: #ccc;
}

.footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
  display: block;
  line-height: 1.6;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.overlay-text {
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  word-break: break-all;
  line-height: 1.4;
}

.overlay-hint {
  position: fixed;
  bottom: 100rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 32rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  background: none;
  border: none;
  border-radius: 0;
  padding: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #07C160;
  font-weight: bold;
}

/* ─── Image section ────────────────────── */
.image-section {
  margin-bottom: 32rpx;
}

.image-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.image-btn:active {
  background: #f9f9f9;
}

.image-btn-active {
  border-left: 6rpx solid #87CEEB;
}

.image-btn-left {
  display: flex;
  align-items: center;
}

.image-btn-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.image-btn-hint {
  font-size: 22rpx;
  color: #bbb;
}

/* ─── Image fullscreen overlay ─────────── */
.image-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 3000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.image-overlay-img {
  width: 100%;
  height: 80vh;
}

.image-overlay-hint {
  position: fixed;
  bottom: 80rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ═══════ New User Guide ═══════ */

/* ── Glow pulse on target elements ── */
.guide-glow {
  animation: glow-pulse 1.2s ease-in-out infinite;
}

@keyframes glow-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(7, 193, 96, 0.4);
    border-color: #07C160;
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(7, 193, 96, 0);
    border-color: #4AE084;
  }
}

/* ── Pin indicators ──────────────── */
.guide-pin {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 4900;
}

.guide-pin-label {
  font-size: 24rpx;
  color: #07C160;
  font-weight: bold;
  white-space: nowrap;
}

.guide-pin-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #07C160;
}

.guide-pin-arrow-up {
  border-top: none;
  border-bottom: 12rpx solid #07C160;
  order: -1;
  margin-bottom: 4rpx;
}

.guide-pin-arrow-down {
  order: 1;
  margin-top: 4rpx;
}

/* Position: above the element, arrow points down */
.guide-pin-above {
  margin-bottom: 8rpx;
}

/* Position: below the element, arrow points up */
.guide-pin-below {
  margin-top: 8rpx;
}

/* Position: left of element, arrow points right */
.guide-pin-left {
  flex-direction: row;
  margin-right: 12rpx;
}

.guide-pin-left .guide-pin-label {
  order: 0;
}

.guide-pin-arrow-right {
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid #07C160;
  border-right: none;
  margin-left: 6rpx;
  order: 1;
}

/* ── Step 0: fullscreen dialog mask ─ */
.guide-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 5000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
}

.guide-dialog-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.guide-dialog-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.guide-dialog-btns {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

/* ── Shared button styles ────────── */
.guide-btn {
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.guide-btn-no {
  background: #f5f5f5;
  color: #999;
}

.guide-btn-yes {
  background: #07C160;
  color: #fff;
}

/* ── Bottom card (steps 1-4) ──────── */
.guide-card {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 5000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.guide-card-blocker {
  flex: 1;
  background: rgba(0, 0, 0, 0.35);
}

.guide-card-inner {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 32rpx;
  text-align: center;
}

/* Step dots */
.guide-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #ddd;
}

.guide-dot-on {
  background: #07C160;
  width: 32rpx;
}

/* Card content */
.guide-card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.guide-card-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  text-align: left;
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}

.guide-card-btns {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.guide-em {
  color: #07C160;
  font-weight: bold;
}
