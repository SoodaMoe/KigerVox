.container {
  padding: 32rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
}

.toolbar-text {
  font-size: 24rpx;
  color: #666;
}

.button-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.btn-card {
  width: 31%;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.btn-card:active {
  transform: scale(0.95);
}

.btn-card-body {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  padding: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.btn-card-footer {
  background: #fafafa;
  padding: 12rpx 8rpx;
  text-align: center;
  border-top: 1rpx solid #f0f0f0;
}

.btn-hint {
  font-size: 22rpx;
  color: #ccc;
}

.btn-hint-silent {
  color: #87CEEB;
}

.btn-speaking {
  border: 3rpx solid #07C160;
  box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.3);
  animation: speaking-pulse 0.8s ease-in-out infinite;
}

@keyframes speaking-pulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.3);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(7, 193, 96, 0.6);
  }
}

.btn-add {
  border: 2rpx dashed #ddd;
  box-shadow: none;
  background: transparent;
}

.btn-add:active {
  border-color: #07C160;
}

.btn-add .btn-card-body {
  height: 160rpx;
}

.add-icon {
  font-size: 64rpx;
  color: #ccc;
}

.footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.overlay-text {
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  word-break: break-all;
  line-height: 1.4;
}

.overlay-hint {
  position: fixed;
  bottom: 100rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  z-index: 1001;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 32rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  background: none;
  border: none;
  border-radius: 0;
  padding: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #07C160;
  font-weight: bold;
}

/* ─── Image section ────────────────────── */
.image-section {
  margin-bottom: 32rpx;
}

.image-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.image-btn:active {
  background: #f9f9f9;
}

.image-btn-active {
  border-left: 6rpx solid #87CEEB;
}

.image-btn-left {
  display: flex;
  align-items: center;
}

.image-btn-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.image-btn-hint {
  font-size: 22rpx;
  color: #bbb;
}

/* ─── Image fullscreen overlay ─────────── */
.image-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 3000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.image-overlay-img {
  width: 100%;
  height: 80vh;
}

.image-overlay-hint {
  position: fixed;
  bottom: 80rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ═══════ New User Guide ═══════ */
.guide-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.88);
  z-index: 5000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Step 0: dialog ──────────────── */
.guide-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  text-align: center;
}

.guide-dialog-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.guide-dialog-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.guide-dialog-btns {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.guide-btn {
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.guide-btn-no {
  background: #f5f5f5;
  color: #999;
}

.guide-btn-yes {
  background: #07C160;
  color: #fff;
}

/* ── Steps 1-4: fullscreen with spotlight ── */
.guide-step {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 5000;
}

/* ── Spotlight punch-out ─────────── */
.guide-spot {
  position: absolute;
  border: 5rpx solid #07C160;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  box-shadow: 0 0 0 999rpx rgba(0, 0, 0, 0.88);
  animation: guide-pulse 1.5s ease-in-out infinite;
}

@keyframes guide-pulse {
  0%, 100% { border-color: #07C160; }
  50% { border-color: #4AE084; }
}

/* Step 1: button grid */
.guide-spot-btns {
  top: 400rpx; left: 24rpx; right: 24rpx;
  height: 400rpx;
  border-radius: 24rpx;
}

/* Step 2: image button row */
.guide-spot-img {
  top: 310rpx; left: 24rpx; right: 24rpx;
  height: 110rpx;
  border-radius: 20rpx;
}

/* Step 3: header title */
.guide-spot-title {
  top: 148rpx; left: 120rpx;
  width: 510rpx; height: 70rpx;
  border-radius: 14rpx;
}

/* Step 4: settings button */
.guide-spot-settings {
  top: 268rpx; right: 24rpx;
  width: 210rpx; height: 66rpx;
  border-radius: 34rpx;
}

/* ── Tip bubble ───────────────────── */
.guide-tip {
  position: absolute;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.35);
  width: 600rpx;
  left: 50%;
  transform: translateX(-50%);
}

.guide-tip-btns { top: 830rpx; }
.guide-tip-img  { top: 470rpx; }
.guide-tip-title { top: 260rpx; }
.guide-tip-settings { top: 380rpx; }

.guide-em {
  color: #07C160;
  font-weight: bold;
}

/* ── Bottom hint ──────────────────── */
.guide-foot {
  position: absolute;
  bottom: 80rpx;
  left: 0; right: 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}
